{
   "action": {
      "default_icon": {
         "128": "icons/icon-128.png",
         "16": "icons/icon-16.png",
         "32": "icons/icon-32.png",
         "48": "icons/icon-48.png"
      },
      "default_popup": "popup.html",
      "default_title": "__MSG_quickSaveTitle__"
   },
   "author": "Sachin",
   "background": {
      "service_worker": "background.js"
   },
   "chrome_url_overrides": {
      "newtab": "newtab.html"
   },
   "commands": {
      "quick-save": {
         "description": "__MSG_quickSaveCommandDescription__",
         "suggested_key": {
            "default": "Ctrl+Shift+Y",
            "mac": "Command+Shift+Y"
         }
      }
   },
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none';"
   },
   "default_locale": "en",
   "description": "__MSG_extensionDescription__",
   "host_permissions": [ "http://*/*", "https://*/*" ],
   "icons": {
      "128": "icons/icon-128.png",
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
   },
   "manifest_version": 3,
   "name": "__MSG_extensionName__",
   "permissions": [ "bookmarks", "storage", "tabs", "activeTab", "notifications", "favicon", "scripting", "alarms", "contextMenus" ],
   "version": "2.0.10"
}
